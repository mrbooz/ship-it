{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".gitignore",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "tests/**",
      "mini-golf/tests/**",
      "server.js",
      "package.json",
      "package-lock.json",
      "codex-integration/**",
      "plugins/**",
      "README.md"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
